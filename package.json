{
  "name": "hangawi-card",
  "version": "0.1.0",
  "description": "Korean-first Chuseok SVG greeting card library, print studio, and CLI.",
  "type": "module",
  "license": "MIT",
  "author": "Chuseok project contributors",
  "keywords": [
    "chuseok",
    "hangawi",
    "svg",
    "greeting-card",
    "korean"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    }
  },
  "types": "./dist/lib/index.d.ts",
  "bin": {
    "hangawi-card": "./dist/cli/index.js"
  },
  "files": [
    "dist/lib",
    "dist/cli",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5178",
    "preview": "vite preview --host 127.0.0.1 --port 5178",
    "prepack": "npm run build:lib",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:lib": "tsc -p tsconfig.build.json",
    "build:site": "vite build",
    "build": "npm run build:lib && npm run build:site",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run pack:smoke && npm run test:e2e"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.2",
    "jsdom": "^27.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.49.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
